pkgtype(kind: "foreign_library")

// Browser transport is linked only for web targets; the DSP library remains
// available on Native through the facade and root packages.

supported_targets = "+js+wasm+wasm-gc"

import {
  "zhr/moonmel/src/facade",
  "moonbitlang/core/json",
}

options(
  link: {
    "js": {
      "exports": [
        "process_audio",
        "process_audio_config",
        "process_wav_bytes",
        "decode_wav_audio",
      ],
    },
    "wasm": {
      "exports": [
        "process_audio",
        "process_audio_config",
        "process_wav_bytes",
        "decode_wav_audio",
      ],
    },
  },
)
